# Example environment variables for the HEATWATCH Supabase API route.
#
# Copy this file to .env.local and replace the placeholder values with your
# real Supabase credentials. The .env.local file is git-ignored; never commit
# it. The service-role key must stay on your machine only.

# Public project URL (safe to share)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Public anon key (client-safe; included for completeness)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-api

# Server-side service-role key (used ONLY in src/app/api/records/route.ts;
# never expose to the browser, never commit, never log it)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-api
